# ─── Secrets (NEVER commit) ─────────────────────────────────────────────────
# Your FreeLLMAPI unified API key. Fetched over SSH from the server by the
# launcher, or set explicitly here for local runs.
FREE_LLM_API_TOKEN=

# ─── Local proxy configuration ──────────────────────────────────────────────
# Where the router proxy listens (default 8792 for v4 auto mode)
CLAUDE_ROUTER_PORT=8792
# Claude Code mode: v1 | v2 | v3 | v4 (v4 = auto meta-router)
CLAUDE_ROUTER_MODE=v4
# Optional: override default model
# CLAUDE_ROUTER_MODEL=gpt-oss-120b

# ─── Upstream FreeLLMAPI ─────────────────────────────────────────────────────
# Base URL of your running FreeLLMAPI instance (typically an SSH-tunneled port)
FREE_LLM_API_BASE=http://127.0.0.1:3004/v1

# ─── SSH tunnel to FreeLLMAPI server ─────────────────────────────────────────
# Used by the launcher to fetch the unified key + open the tunnel
# FREELLM_TUNNEL_HOST=freellmapi-tunnel
# FREELLM_REMOTE_PORT=3001
# FREELLM_LOCAL_PORT=3004

# ─── Optional diagnostics ────────────────────────────────────────────────────
# Enable verbose proxy logging
# MVP_VERBOSE=1
